{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeiloria.github.io/paramecia-core/schemas/canon-metadata.schema.json",
  "title": "Whisperwood Canon Metadata",
  "type": "object",
  "required": ["record_id", "record_type", "authority_tier", "lifecycle_state", "artifact_role", "review_state", "provenance"],
  "properties": {
    "record_id": {"type": "string", "pattern": "^WW-LOC-[0-9]{4}$"},
    "record_type": {"const": "location"},
    "authority_tier": {"enum": ["A0", "A1", "A2", "A3", "A4"]},
    "lifecycle_state": {"enum": ["draft", "candidate", "approved", "superseded", "retired", "quarantined"]},
    "artifact_role": {"enum": ["source", "registry", "compiler", "generated_output", "reference", "index", "test_fixture"]},
    "review_state": {"enum": ["needs_source_recovery", "needs_adjudication", "reviewed"]},
    "provenance": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["source_url", "source_title", "source_section", "source_excerpt"],
        "properties": {"source_url": {"type": "string", "format": "uri"}, "source_title": {"type": "string", "minLength": 1}, "source_section": {"type": "string", "minLength": 1}, "source_excerpt": {"type": "string", "minLength": 1}},
        "additionalProperties": false}
    },
    "promotion_approval": {
      "type": "object", "required": ["approver", "decision_ref", "approved_at"],
      "properties": {"approver": {"type": "string", "minLength": 1}, "decision_ref": {"type": "string", "minLength": 1}, "approved_at": {"type": "string", "format": "date"}},
      "additionalProperties": false
    }
  },
  "allOf": [{"if": {"properties": {"lifecycle_state": {"const": "approved"}}, "required": ["lifecycle_state"]}, "then": {"required": ["promotion_approval"]}}],
  "additionalProperties": true
}
